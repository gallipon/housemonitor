# HouseMonitor サーバー側 DB設定
# Apache: SetEnv または .htaccess で設定
# nginx: fastcgi_param で設定
#
# 例（.htaccess の場合）:
#   SetEnv DB_HOST localhost
#   SetEnv DB_USER raspi
#   SetEnv DB_PASS your_password_here
#   SetEnv DB_NAME raspi
#   SetEnv HOUSEMONITOR_API_KEY your_random_api_key_here
#   SetEnv HOUSEMONITOR_DASHBOARD_PASSWORD your_dashboard_password_here
#   SetEnv HOUSEMONITOR_NTFY_TOPIC your_ntfy_topic_name
#
# 任意: BME280 データの参照元テーブル/ビュー（既定 bme280）
# センサー個体のドリフト補正ビュー等を使う場合のみ指定する
#   SetEnv HOUSEMONITOR_BME280_TABLE bme280_corrected

DB_HOST=localhost
DB_USER=raspi
DB_PASS=your_password_here
DB_NAME=raspi
HOUSEMONITOR_API_KEY=your_random_api_key_here
HOUSEMONITOR_DASHBOARD_PASSWORD=your_dashboard_password_here
HOUSEMONITOR_NTFY_TOPIC=your_ntfy_topic_name

# 任意（既定: bme280）。補正ビュー等を使う場合のみ設定
#HOUSEMONITOR_BME280_TABLE=bme280_corrected
